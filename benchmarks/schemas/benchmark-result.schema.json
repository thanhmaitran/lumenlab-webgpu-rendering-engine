{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lumenlab/lumenlab-webgpu-rendering-engine/benchmarks/schemas/benchmark-result.schema.json",
  "title": "LumenLab benchmark result",
  "description": "One measured run of one benchmark scenario. Every value is measured; metrics the environment cannot provide are null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scenarioId",
    "runId",
    "runIndex",
    "timestamp",
    "browser",
    "deviceLabel",
    "softwareAdapter",
    "canvasWidth",
    "canvasHeight",
    "objectCount",
    "triangleCount",
    "drawCalls",
    "shadowDrawCalls",
    "shadowsEnabled",
    "shadowMapSize",
    "renderMode",
    "warmupFrames",
    "measuredFrames",
    "frameTimeMedianMs",
    "frameTimeP95Ms",
    "frameTimeMeanMs",
    "frameTimeStdDevMs",
    "frameTimeMinMs",
    "frameTimeMaxMs",
    "cpuTimeMedianMs",
    "cpuTimeP95Ms",
    "gpuTimeMedianMs",
    "gpuTimeP95Ms",
    "gpuSamples",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scenarioId": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "runIndex": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string", "format": "date-time" },
    "browser": { "type": "string", "minLength": 1 },
    "deviceLabel": { "type": "string", "minLength": 1 },
    "softwareAdapter": {
      "type": "boolean",
      "description": "True for software/fallback adapters such as SwiftShader."
    },
    "canvasWidth": { "type": "integer", "minimum": 1 },
    "canvasHeight": { "type": "integer", "minimum": 1 },
    "objectCount": { "type": "integer", "minimum": 0 },
    "triangleCount": { "type": "integer", "minimum": 0 },
    "drawCalls": { "type": "integer", "minimum": 0 },
    "shadowDrawCalls": { "type": "integer", "minimum": 0 },
    "shadowsEnabled": { "type": "boolean" },
    "shadowMapSize": { "type": "integer", "minimum": 1 },
    "renderMode": { "type": "string" },
    "warmupFrames": { "type": "integer", "minimum": 0 },
    "measuredFrames": { "type": "integer", "minimum": 1 },
    "frameTimeMedianMs": {
      "type": "number",
      "minimum": 0,
      "description": "CPU submit until GPU queue idle (ms)."
    },
    "frameTimeP95Ms": { "type": "number", "minimum": 0 },
    "frameTimeMeanMs": { "type": "number", "minimum": 0 },
    "frameTimeStdDevMs": { "type": "number", "minimum": 0 },
    "frameTimeMinMs": { "type": "number", "minimum": 0 },
    "frameTimeMaxMs": { "type": "number", "minimum": 0 },
    "cpuTimeMedianMs": { "type": "number", "minimum": 0 },
    "cpuTimeP95Ms": { "type": "number", "minimum": 0 },
    "gpuTimeMedianMs": { "type": ["number", "null"], "minimum": 0 },
    "gpuTimeP95Ms": { "type": ["number", "null"], "minimum": 0 },
    "gpuSamples": { "type": "integer", "minimum": 0 },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
